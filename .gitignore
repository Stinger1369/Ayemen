# Global ignores (appliqué à la racine du projet)
.DS_Store
Thumbs.db

# Exclusions pour Node.js (applicable aux deux dossiers)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environnement
.env
.env.test
.env.production
.env.local
.env.*.local

# Dependency directories
node_modules/
jspm_packages/

# Lint et autres fichiers temporaires
.eslintcache
*.tsbuildinfo

# Yarn Berry (Pnp)
.pnp.*
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.yarnrc.yml

# Static/Binaries
*.exe
*.dll
*.so
*.dylib

# Frontend (React + Vite.js)
frontend/.vscode/
frontend/node_modules/
frontend/.cache/
frontend/dist/
frontend/*.br
frontend/*.gz

# Backend (NestJS)
backend/.vscode/
backend/node_modules/
backend/dist/
backend/*.js
backend/*.js.map
backend/*.d.ts
backend/public/
backend/uploads/
backend/*.br
backend/*.gz
backend/coverage/
backend/TestResults.xml

# AL-specific (Dynamics 365 Business Central)
.vscode/
.alcache/
.alpackages/
.snapshots/
.output/
*.app
rad.json
*.g.xlf
*.flf
TestResults.xml
